{
  "name": "digital-twin-lab",
  "private": true,
  "type": "module",
  "scripts": {
    "sim": "node --use-system-ca --env-file-if-exists=.env server/sim.mjs",
    "discover:townships": "node --use-system-ca scripts/discover-townships.mjs",
    "fetch:township": "node --use-system-ca scripts/fetch-township.mjs",
    "fetch:cameras": "node --use-system-ca scripts/fetch-cameras.mjs",
    "test": "npm run test:feeds && npm run test:township && npm run test:advisor && npm run test:geometry && npm run test:snapshot && npm run test:mapbuildings && npm run test:tiles && npm run test:street && npm run test:cameras",
    "test:feeds": "node server/feeds.test.mjs",
    "test:township": "node server/township.test.mjs",
    "test:advisor": "node test/advisor.test.ts",
    "test:geometry": "node test/geometry.test.ts",
    "test:snapshot": "node test/snapshot.test.ts",
    "test:mapbuildings": "node test/map-buildings.test.ts",
    "dev": "vite",
    "build": "vite build",
    "test:tiles": "node test/tiles.test.ts",
    "test:street": "node test/mapillary-search.test.ts",
    "test:cameras": "node test/camera-data.test.mjs"
  },
  "dependencies": {
    "mapillary-js": "^4.1.2",
    "maplibre-gl": "^5.21.0",
    "three": "^0.187.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
