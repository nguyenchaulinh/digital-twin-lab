# Copy to .env (git-ignored) and fill in. Free token: https://aqicn.org/data-platform/token/
AQICN_TOKEN=
# Air quality comes from the AQICN station nearest to the township being viewed

# Street view: a Mapillary client token (MLY|...), free at https://www.mapillary.com/dashboard/developers
# Read by Vite, so it is built into the page like any VITE_ variable: use a client token, never a secret.
# Leave empty to hide the street view buttons.
VITE_MAPILLARY_TOKEN=
